{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RequestTiming": {
    "SlowRequestThresholdMs": 500
  },
  "JwtSettings": {
    "Issuer": "PostsAPI",
    "Audience": "PostsAPI",
    "ExpiryMinutes": 60
  }
}
